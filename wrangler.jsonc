// Frontend is static assets only (proposal 7.1). API and WebSocket live on the backend side.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agi-board-frontend",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "staging": { "name": "agi-board-frontend-staging" },
    "production": { "name": "agi-board-frontend-production" },
  },
}
