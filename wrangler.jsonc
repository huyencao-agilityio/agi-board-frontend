// Frontend is static assets only (proposal 7.1). API and WebSocket live on the backend side.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agi-board-frontend",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    // Worker names set the URLs: https://<name>.huyen-cao.workers.dev (backend APP_ORIGIN must match).
    "staging": { "name": "agi-board-staging" },
    "production": { "name": "agi-board-app" },
  },
}
