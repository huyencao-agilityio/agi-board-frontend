// Static assets, plus a thin Worker that forwards /api/* to the backend (service binding "API") so the API is same-origin.
// WebSocket still goes straight to the backend side.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agi-board-frontend",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "env": {
    // Worker names set the URLs: https://<name>.huyen-cao.workers.dev (backend APP_ORIGIN must match).
    "staging": {
      "name": "agi-board-staging",
      "services": [{ "binding": "API", "service": "agi-board-backend-staging" }],
    },
    "production": {
      "name": "agi-board-app",
      "services": [{ "binding": "API", "service": "agi-board-backend-production" }],
    },
  },
}
